# ── Server ──────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database (Supabase PostgreSQL) ──────────────────
DATABASE_URL=postgresql://user:password@host:6543/dbname?pgbouncer=true

# ── Auth (JWT) ──────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Supabase (optional, for Row-Level Security) ─────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Launch API and CORS ────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── OTP provider (console is development-only) ─────
OTP_PROVIDER=console
OTP_SENDER_ID=QUICKB
OTP_PROVIDER_API_KEY=
OTP_PROVIDER_API_SECRET=

# ── Online payment provider (required before pilot)
PAYMENT_PROVIDER=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
