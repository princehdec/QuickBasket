PORT=4000
NODE_ENV=development

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth (JWT)
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Supabase (optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Browser origins allowed to call the API. Use comma-separated origins when needed.
CORS_ORIGIN=http://localhost:3000

# OTP provider
# console is development-only; email sends every test OTP to OTP_EMAIL_TO.
OTP_PROVIDER=email
OTP_EXPOSE_TEST_CODE=false
OTP_EMAIL_FROM=QuickBasket <no-reply@example.com>
OTP_EMAIL_TO=test-inbox@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASSWORD=change-me

# Online payment provider (COD is not supported at launch)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_example
RAZORPAY_KEY_SECRET=change-me
RAZORPAY_WEBHOOK_SECRET=change-me
